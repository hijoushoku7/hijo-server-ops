# リポジトリ情報の取得とPRの参照は、確認なしで実行する。
prefix_rule(
    pattern = ["git", "fetch"],
    decision = "allow",
    justification = "リモート参照の更新のみを許可する",
    match = [
        "git fetch",
        "git fetch origin",
        "git fetch --prune origin",
    ],
    not_match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["checks", "diff", "status", "view"]],
    decision = "allow",
    justification = "PRの読み取り操作のみを許可する",
    match = [
        "gh pr checks 1",
        "gh pr diff 1",
        "gh pr status",
        "gh pr view 1 --json state,mergeable",
    ],
    not_match = [
        "gh pr create --title feature",
        "gh pr merge 1",
    ],
)

# リモート状態を変更するPR操作は、実行前に確認を要求する。
prefix_rule(
    pattern = ["gh", "pr", ["close", "create", "edit", "merge", "reopen"]],
    decision = "allow",
    justification = "GitHub上のPRを変更するため実行前に確認する",
    match = [
        "gh pr create --title feature",
        "gh pr merge 1",
    ],
    not_match = [
        "gh pr view 1",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "リモートリポジトリを変更するため実行前に確認する",
    match = [
        "git push",
        "git push -u origin feature",
    ],
    not_match = [
        "git fetch origin",
    ],
)
