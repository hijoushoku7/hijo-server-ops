#compdef hso

_hso() {
    local out
    local -a candidates
    # words は 1 始まりだが ${...:offset:length} の offset は 0 始まり。
    # 先頭の hso から、いま打ちかけの CURRENT 番目までをそのまま渡す。
    out=$(hso __complete "${words[@]:0:$CURRENT}" 2>/dev/null)
    if [[ $out == ':files' ]]; then
        _files
        return
    fi
    candidates=("${(@f)out}")
    candidates=("${candidates[@]/$'\t'/:}")
    _describe 'hso' candidates
}

# fpath から autoload されるとこのファイル全体が _hso の本体になる。その場合は
# 最後に自分を呼ばないと 1 回目の Tab が関数定義だけで終わって候補が出ない。
# source で読まれたときは compdef で登録するだけでよい。
if [[ $funcstack[1] == _hso ]]; then
    _hso "$@"
else
    compdef _hso hso
fi
